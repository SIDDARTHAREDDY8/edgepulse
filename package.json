{
  "name": "edgepulse",
  "version": "1.0.0",
  "description": "Privacy-first event analytics on Cloudflare Workers + D1, with a built-in MCP server for AI agents.",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply edgepulse --local",
    "db:migrate:remote": "wrangler d1 migrations apply edgepulse --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Siddartha Reddy Chinthala",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "private": true,
  "type": "module"
}
